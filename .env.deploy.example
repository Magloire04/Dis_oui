# Coordonnées du serveur de production, lues par scripts/deploy.sh.
#
# Copier ce fichier en `.env.deploy` et le renseigner. Le fichier réel n'est
# pas versionné : ce dépôt est public, et y publier l'utilisateur SSH,
# l'adresse et le port offrirait de la reconnaissance gratuite à un attaquant.

# Accès SSH
SSH_HOTE=203.0.113.10
SSH_UTILISATEUR=utilisateur
SSH_PORT=22
SSH_CLE=~/.ssh/id_rsa

# Chemin absolu de l'application sur le serveur
APP_DISTANTE=/home/utilisateur/apps/disoui

# Chemin de l'application relatif au dossier personnel, tel qu'attendu par
# cloudlinux-selector (donc sans le /home/utilisateur/ initial)
APP_ROOT_RELATIF=apps/disoui

# Environnement Node créé par le sélecteur cPanel. Sans son activation, la
# commande `node` n'existe pas dans le PATH de l'hébergement mutualisé.
NODEENV_DISTANT=/home/utilisateur/nodevenv/apps/disoui/24

# URL publique, utilisée pour vérifier que le site répond après redémarrage
URL_PUBLIQUE=https://disoui.bytechnum.com

# Facultatif : mot de passe de la console d'exploitation. Renseigné, le script
# vérifie en fin de déploiement que le transport d'e-mail est bien actif.
ADMIN_MOT_DE_PASSE=
