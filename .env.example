# Copier ce fichier en `.env` et renseigner les valeurs.
# Générer les secrets avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Base de données MySQL.
# Les tests utilisent automatiquement la même base suffixée `_test`
# (ici `dis_oui_test`), à créer au préalable :
#   CREATE DATABASE dis_oui_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# TEST_DATABASE_URL permet de viser une autre base si besoin.
DATABASE_URL=mysql://root@127.0.0.1:3306/dis_oui

# Secret de signature des sessions JWT
JWT_SECRET=

# Sel du hachage des adresses IP (rate limiting sans stockage d'IP en clair)
IP_HASH_SALT=

# Port du serveur Express (auto-incrémenté si occupé)
PORT=3000

# --- Envoi d'e-mails --------------------------------------------------------
# Le transport est choisi dans cet ordre : SMTP_HOST renseigné -> smtp,
# sinon MAIL_TRANSPORT=sendmail -> binaire local, sinon RESEND_API_KEY ->
# Resend, sinon affichage en console. Tout laisser vide en local suffit.

# Adresse d'expédition, commune à tous les transports.
MAIL_FROM="Dis oui <disoui@bytechnum.com>"

# 1. Serveur SMTP authentifié
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# 2. Binaire local, cas de l'hébergement mutualisé cPanel : aucune boîte n'est
#    nécessaire, le SPF du domaine autorisant déjà le serveur.
MAIL_TRANSPORT=
SENDMAIL_PATH=/usr/sbin/sendmail

# 3. Resend
RESEND_API_KEY=
RESEND_FROM="Dis oui <onboarding@resend.dev>"

# URL publique utilisée dans les liens des e-mails
PUBLIC_BASE_URL=http://localhost:3000

# Mot de passe unique de la console d'exploitation, sur /admin.
# Laissé vide, la console est inaccessible : c'est le comportement voulu tant
# qu'aucun mot de passe n'a été choisi.
ADMIN_PASSWORD=

# Jeton de la route de purge appelée par le cron, sur les hébergements où
# l'application est mise en veille faute de trafic (Passenger).
#   POST /api/cron/purge  avec l'en-tête  X-Cron-Token
CRON_TOKEN=
